{
  "info": {
    "_postman_id": "a1d4b8e2-9f23-4c1a-8e11-202611080001",
    "name": "TaskFlow API - Functional & Negative Suite",
    "description": "End-to-end API validation: health, authentication, CRUD, response contracts, validation and authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health endpoint returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Health response contract', () => { const b=pm.response.json(); pm.expect(b.status).to.eql('ok'); pm.expect(b.service).to.eql('TaskFlow API'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"Admin123!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json(); pm.environment.set('adminToken', body.access_token);",
              "pm.test('Admin role and bearer token', () => { pm.expect(body.role).to.eql('admin'); pm.expect(body.token_type).to.eql('bearer'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - User login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"qa_user\",\"password\":\"User123!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User login succeeds', () => pm.response.to.have.status(200));",
              "pm.environment.set('userToken', pm.response.json().access_token);",
              "pm.test('User role returned', () => pm.expect(pm.response.json().role).to.eql('user'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Newman acceptance task\",\"description\":\"Created by the Postman collection\",\"status\":\"pending\"}"
        },
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); pm.environment.set('taskId', b.id);",
              "pm.test('Response schema is complete', () => { ['id','title','description','status','owner_id','created_at','updated_at'].forEach(k => pm.expect(b).to.have.property(k)); });",
              "pm.test('Created values match request', () => { pm.expect(b.title).to.eql('Newman acceptance task'); pm.expect(b.status).to.eql('pending'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List returns 200', () => pm.response.to.have.status(200));",
              "pm.test('List is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('Created task is present', () => pm.expect(pm.response.json().some(t => t.id == pm.environment.get('taskId'))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Get task",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Returned task ID matches', () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('taskId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Update task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Updated by Newman\",\"status\":\"completed\"}"
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Updated values persisted', () => { const b=pm.response.json(); pm.expect(b.title).to.eql('Updated by Newman'); pm.expect(b.status).to.eql('completed'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Second user login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"second_user\",\"password\":\"User123!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Second user login succeeds', () => pm.response.to.have.status(200));",
              "pm.environment.set('secondToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Authorization blocks cross-user access",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{secondToken}}"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cross-user read is forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Invalid payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"ab\"}"
        },
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid title is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Missing token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthenticated request is rejected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Delete task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Confirm deleted task is absent",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted resource returns 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}